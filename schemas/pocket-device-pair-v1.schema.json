{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itsnotailabs.dev/schemas/pocket-device-pair-v1.schema.json",
  "title": "pocket.device.pair.v1 redeem result",
  "type": "object",
  "properties": {
    "ok": { "type": "boolean" },
    "need": { "enum": ["webauthn"] },
    "user": { "type": "string", "pattern": "^device:" },
    "role": { "const": "portal_device" },
    "is_owner": { "const": false },
    "device_id": { "type": "string" },
    "capability": { "const": "portal" },
    "grant_id": { "type": "string" },
    "via": { "const": "device-pair+webauthn" }
  }
}
