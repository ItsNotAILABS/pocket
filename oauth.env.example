# Copy to %USERPROFILE%\.pocket\oauth.env  (never commit the filled file)
# GitHub: https://github.com/settings/developers → OAuth App
#   Homepage: http://127.0.0.1:8787/
#   Callback: http://127.0.0.1:8787/v1/auth/oauth/github/callback
#   Also add: https://pocket.medinatechlabs.net/v1/auth/oauth/github/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
POCKET_OWNER_GITHUB=FreddyCreates

# Optional extra providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
